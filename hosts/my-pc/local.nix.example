{ config, lib, pkgs, ... }:
{
	system.stateVersion = "26.05";

	users.users.banumath.extraGroups = [ "input" "dialout" "uinput" ];

	nihil.extraWallpapers = lib.optional (builtins.pathExists ./wallpapers) ./wallpapers;

	nix.settings.substituters = [ "https://freesmlauncher.cachix.org" "https://cache.nixos.org/" ];
	nix.settings.trusted-public-keys = [
		"freesmlauncher.cachix.org-1:Jcp5Q9wiLL+EDv8Mh7c6L9xGk+lXr7/otpKxMOuBuDs="
		"cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY="
	];

	networking.firewall.allowedTCPPorts = [ 24850 ];
}
